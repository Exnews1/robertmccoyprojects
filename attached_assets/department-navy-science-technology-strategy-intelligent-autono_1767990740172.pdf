     <rdf:li xml:lang="x-default">210419-N-NO842-1003</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">210419-N-NO842-1003 SAN DIEGO (April 19, 2021) A CARINA unmanned undersea glider from Unmanned Undersea Vehicles (UUV) Squadron 1 launches in support of U.S. Pacific Fleetâ€™s UxS IBP 21, April 19. UxS IBP 21 integrates manned and unmanned capabilities into operational scenarios to generate warfighting advantages. (Courtesy U.S. Navy photo)</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Public Domain</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:subject>

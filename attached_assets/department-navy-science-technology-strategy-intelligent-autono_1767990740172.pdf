   photoshop:Headline="IBP 21 CARINA Launch"
   photoshop:City="San Diego"
   photoshop:State="California"
   photoshop:Country="United States"
   photoshop:Source="Digital"
   photoshop:AuthorsPosition="Commander, U.S. 3rd Fleet"

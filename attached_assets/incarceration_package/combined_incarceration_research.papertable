        {
            "papers_Knp69H": {
                "id": 4072242415,
                "title": "The Role of Incarceration-Based Education in Recidivism Reduction: A Literature Review",
                "is_archived": false,
                "full_slug": "the-role-of-incarceration-based-education-in-recidivism-pwbdydvp5bds",
                "journal": {
                    "display_name": "Journal of Student Research",
                    "official_page": "http://beyhagh.medsab.ac.ir",
                    "issn": "2167-1907",
                    "alias": [
                        "JSR",
                        "JOFSR"
                    ],
                    "id": 2765069361,
                    "slug": "journal-of-student-research",
                    "unique_id": "2v8exvf5",
                    "full_slug": "journal-of-student-research-2v8exvf5"
                },
                "conference_series": null,
                "date": "2024-11-30 00:00:00+00:00",
                "is_oa": null,
                "publication_type": "Journal Article",
                "doi": "10.47611/jsrhs.v13i4.7725",
                "unique_id": "pwbdydvp5bds",
                "abstract": "Higher education, GED programs, and vocational training play a major role in reducing recidivism among incarcerated individuals. Research shows that these educational initiatives inside incarceration not only lower recidivism rates but also support successful reintegration into society by increasing employment opportunities. This paper aims to analyze the effectiveness of each educational program and its direct impact on recidivism. Despite the effectiveness of each educational program in reducing recidivism rates among previously incarcerated individuals, challenges such as limited access, program quality, and post-release support persist. Recommendations for enhancing these program's effectiveness and impact include expanding access to higher education within correctional facilities, improving the delivery and integration of GED programs, increasing investment in vocational training aligned with labor market trends, developing holistic reentry programs that address various post-incarceration challenges, and standardizing recidivism definitions for more reliable research. Addressing these recommendations can strengthen the impact of correctional education programs, reduce recidivism, and promote successful reintegration, ultimately further contributing to increased public safety and economic stability. ",
                "authors": {
                    "total": 2,
                    "data": [
                        {
                            "display_name": "Matthew F. Griffith",
                            "full_slug": null
                        },
                        {
                            "display_name": "H Zettler",
                            "full_slug": null
                        }
                    ]
                },
                "affiliations": {
                    "total": 0,
                    "data": []
                },
                "is_fulltext_request_allowed": false,
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "This literature review examines the effectiveness of incarceration-based education in reducing recidivism, highlighting the benefits of higher education, GED programs, and vocational training in increasing employment opportunities and successful reintegration into society.",
                "podcast": null,
                "podcast_generation_allowed": true,
                "entity_type": "PAPER",
                "rank": 17,
                "relevance_data": {},
                "source": "scispace",
                "relevance_summary": "Uses incarceration-based education programs to examine recidivism, directly addressing prisoners and their schooling outcomes. Lacks discussion of entry age, rights, or mental health; briefly notes access barriers and preferences.",

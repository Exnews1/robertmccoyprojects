                        ]
                    },
                    "is_show": true
                },
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "In this article , the authors identify barriers limiting access to education, while incarcerated and post-release, and how such barriers can be mitigated, using Critical Race Theory as a paradigm and thematic analysis as a methodology.",
                "podcast": null,
                "podcast_generation_allowed": true,
                "entity_type": "PAPER",

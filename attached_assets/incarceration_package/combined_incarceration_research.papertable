                            "full_slug": null
                        },
                        {
                            "display_name": "Edisson Fabian Guangasi-Lagua",
                            "full_slug": null
                        },
                        {
                            "display_name": "Frida Alejandra Villamar\u00edn-Chuma\u00f1a",
                            "full_slug": null
                        }
                    ]
                },
                "affiliations": {
                    "total": 0,
                    "data": []
                },
                "is_fulltext_request_allowed": false,
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "This qualitative study examines 16 recent academic publications (2020-2023) on human rights of persons deprived of liberty, revealing a significant gap between normative frameworks and carceral reality, characterized by overcrowding, institutional violence, and ineffective rehabilitation programs.",

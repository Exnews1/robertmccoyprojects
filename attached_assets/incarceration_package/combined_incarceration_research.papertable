                        "total": null
                    }
                },
                "tldr": "The role of prisoner voice in criminal justice reform in the US has been examined in this article, concluding that prisoner litigation and prison riots result in reform that drives the growth of state prison systems and loss of prisoner privileges.",
                "podcast": null,
                "podcast_generation_allowed": true,

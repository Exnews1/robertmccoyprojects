                "tldr": "In this article , a systematic search of the articles on Oxford Academic Journals, Emerald Insight, Science Direct, PubMed, and Google Scholar using the keywords \"Mental Health\" OR \"Health\" AND \"Needs\" OR \u201cNeeds Assessment\u201d or \u201cAddressing Needs\u201d AND \u201cFemale\u201d OR \u2018Woman OR \u201eOr \u201cWomen\u201d And \u201cInmates\u201d Or \u201cPrisoners\u201d",
                "podcast": null,
                "podcast_generation_allowed": true,
                "entity_type": "PAPER",
                "rank": 4,
                "relevance_data": {},
                "source": "scispace",
                "relevance_summary": "Uses scoping review to identify mental health needs of women prisoners, directly addressing incarcerated population and mental health. Lacks education, age\u2011entry, rights, and cross\u2011jurisdiction comparisons; includes systematic needs assessment.",
                "relevance_metadata": {
                    "criteria_judgments": [
                        {
                            "criterion_name": "Incarcerated Population Focus",
                            "relevance": "Perfectly Relevant"
                        },
                        {

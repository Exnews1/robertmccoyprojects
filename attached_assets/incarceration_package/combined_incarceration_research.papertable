            "papers_Knp69H": {
                "id": 2985596450,
                "title": "Reflections on Representing Incarcerated People with Disabilities: Ableism in Prison Reform Litigation",
                "is_archived": false,
                "full_slug": "reflections-on-representing-incarcerated-people-with-2rm25ge168",
                "journal": {
                    "display_name": "Social Science Research Network",
                    "official_page": "http://www.ssrn.com/",
                    "issn": null,
                    "alias": [
                        "SSRN",
                        "ssrn.com"
                    ],
                    "id": 2751751161,
                    "slug": "social-science-research-network",
                    "unique_id": "195okree",
                    "full_slug": "social-science-research-network-195okree"
                },
                "conference_series": null,
                "date": "2019-07-22 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Journal Article",
                "doi": "10.2139/SSRN.3424341",
                "unique_id": "2rm25ge168",
                "abstract": "Over the last five decades, advocates have fought for and secured constitutional prohibitions challenging solitary confinement, including ending the placement and prolonged isolation of individuals with psychiatric disabilities in solitary confinement. Yet, despite the valiant efforts of this courageous movement to protect the rights of incarcerated people with disabilities through litigation, the legal regime protecting these rights reflects a troubling paradigm: ableism.\r\n\r\nAbleism is a complex system of cultural, political, economic, and social practices that facilitate, construct, or reinforce the subordination of people with disabilities in a given society. In this Essay I argue that current Eighth Amendment jurisprudence in prison conditions of confinement cases in some ways requires lawyers to engage in ableism to protect their clients from harsh and inhumane treatment. The complexity of this arrangement \u2014 as between protecting and expanding the rights of people with disabilities and reinforcing practices that facilitate their exclusion and subordination \u2014 is both a cause and effect of ableism, particularly in the area of Eighth Amendment jurisprudence. Though entrenched in our legal institutions, the overrepresentation of people with disabilities in the criminal legal system calls for a new approach to the representation of these individuals. Toward that end, this Essay proposes a series of interventions in both law and professional practice to reduce the reliance on, and effect of, ableism in representing people with disabilities in the prison reform litigation.",
                "authors": {
                    "total": 1,
                    "data": [

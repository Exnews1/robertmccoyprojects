                            "id": 2218657348,
                            "slug": "padraig-mcbennett",
                            "unique_id": "rlt0rfdyoz",
                            "full_slug": "padraig-mcbennett-rlt0rfdyoz",
                            "affiliation_full_slug": "university-college-dublin-2uzykgj9"
                        },
                        {
                            "display_name": "Jan deVries",
                            "id": 2644841331,

        {
            "papers_Knp69H": {
                "id": 3131811974,
                "title": "The Importance of Incorporating Lived Experience in Efforts to Reduce Australian Reincarceration Rates",
                "is_archived": false,
                "full_slug": "the-importance-of-incorporating-lived-experience-in-efforts-4m3wf5ky4j",
                "journal": {
                    "display_name": "International Journal for Crime, Justice and Social Democracy",
                    "official_page": "https://www.crimejusticejournal.com/index",
                    "issn": "2202-8005",
                    "alias": null,
                    "id": 2738560774,
                    "slug": "international-journal-for-crime-justice-and-social-democracy",
                    "unique_id": "3dmkr36i",
                    "full_slug": "international-journal-for-crime-justice-and-social-democracy-3dmkr36i"
                },
                "conference_series": null,
                "date": "2021-02-17 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Journal Article",
                "doi": "10.5204/IJCJSD.1666",
                "unique_id": "4m3wf5ky4j",
                "abstract": "It is widely acknowledged that \u2018good policy\u2019 should be informed by the people it most directly affects. However, learning from people with lived experiences in the criminal justice sector, such as people who have served time in prison, has received little attention. This article discusses the significance of and challenges related to capturing the voices of people who are currently serving time or have served time in prison. We argue that formalising the perspectives of these individuals into policymaking through co-design processes may be an important method for enhancing program responses to rising incarceration and reincarceration rates.",
                "authors": {
                    "total": 3,
                    "data": [

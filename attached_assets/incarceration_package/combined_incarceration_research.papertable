        {
            "papers_Knp69H": {
                "id": 2743183159,
                "title": "Female inmates perspectives on incarceration and correctional education at Coffee Creek Correctional Facility",
                "is_archived": false,
                "full_slug": "female-inmates-perspectives-on-incarceration-and-3rjmc5no7x",
                "journal": null,
                "conference_series": null,
                "date": "2005-01-01 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Dissertation",
                "doi": "10.15760/ETD.5216",
                "unique_id": "3rjmc5no7x",
                "abstract": "An abstract of the thesis of Clara Guadalupe Ellis for the Master of Arts in Anthropology presented November 3, 2005. Title: Female Inmates'Perspectives on Incarceration and Correctional Education at Coffee Creek Correctional Facility Prisons provide us with a place to segregate criminals from the population at large, but the ongoing question is what to do with them once we have incarcerated them? On one side there is the idea that prisons should be used to punish those who have broken the law. On the other is the idea that prisons should help to rehabilitate prisoners so that they may be reintegrated into society upon their release. The purpose of this study was to examine the role correctional education programs played in the life of female offenders in light of the debate mentioned above. Based on qualitative research, the aim of this study was to listen to the prisoner's voice. What did inmates think about correctional education programs offered? Did they want such programs? Did they feel empowered by them, or did they resist being 'rehabilitated' and feign compliance? How did inmates make sense of their learning experience?",
                "authors": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "Clara Guadalupe Ellis",
                            "id": 2743528376,
                            "slug": "clara-guadalupe-ellis",
                            "unique_id": "32lclbsqyl",
                            "full_slug": "clara-guadalupe-ellis-32lclbsqyl"
                        }
                    ]
                },
                "affiliations": {

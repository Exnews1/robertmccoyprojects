        {
            "papers_Knp69H": {
                "id": 2914935160,
                "title": "An Analysis and Critique of Mental Health Treatment in American State Prisons and Proposal for Improved Care",
                "is_archived": false,
                "full_slug": "an-analysis-and-critique-of-mental-health-treatment-in-1usk38fgnj",
                "journal": null,
                "conference_series": null,
                "date": "2019-01-01 00:00:00+00:00",
                "is_oa": true,
                "publication_type": null,
                "doi": null,
                "unique_id": "1usk38fgnj",
                "abstract": "Mental health treatment in state prisons is revealed to be highly variable, under-funded, and systematically inadequate. Existing literature exposes this injustice but fails to provide a comprehensive proposal for reform. This paper attempts to fill that gap, outlining a costeffective, evidence-based treatment proposal, directly addressing the deficits in care revealed through analysis of our current system. In addition, this paper provides historical overviews of the prison system and mental health treatment, utilizing theoretical perspectives to contextualize this proposal in the present state of affairs. Lastly, the evidence is provided to emphasize the potential economic and social benefits of improving mental health treatment in state prisons. Significant findings suggest a clear financial, legal, and moral incentive for states to address this issue, while the proposal provides a viable method of doing so.",
                "authors": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "Shelby Hayne",
                            "id": 2914581574,
                            "slug": "shelby-hayne",
                            "unique_id": "2lpkmtoqou",
                            "full_slug": "shelby-hayne-2lpkmtoqou"
                        }
                    ]
                },

        {
            "papers_Knp69H": {
                "id": 1590089838,
                "title": "Prisoners as Citizens",
                "is_archived": false,
                "full_slug": "prisoners-as-citizens-2udu4j3qn5",
                "journal": null,
                "conference_series": null,
                "date": "2002-06-01 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Book Chapter",
                "doi": null,
                "unique_id": "2udu4j3qn5",
                "abstract": "As prison populations continue to expand across the western world the question of the rights of prisoners has become an increasingly pressing issue, particularly in the light of new human rights discourses\r\n\r\nThis important new book gives voice to a diverse range of viewpoints arising out of this debate in the Australian context, while the issues raised will have powerful echoes elsewhere The contributors to this book include the prisoners themselves, human rights activists, academics, criminal justice policy makers and practitioners\r\n\r\nOverall the book presents a powerful argument that prisoners do and should have rights in any society that professes to be a democracy, bringing to the fore a debate that society would often prefer to forget",
                "authors": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "David Brown",

        {
            "papers_Knp69H": {
                "id": 4059248889,
                "title": "The Dimensions, Pathways, and Consequences of Youth Reentry",
                "is_archived": false,
                "full_slug": "the-dimensions-pathways-and-consequences-of-youth-reentry-td5zkrkct1z7",
                "journal": null,
                "conference_series": null,
                "date": null,
                "is_oa": null,
                "publication_type": null,
                "doi": "10.1037/e690662011-001",
                "unique_id": "td5zkrkct1z7",
                "abstract": "Approximately 200,000 juveniles and young adults age 24 and under leave secure juvenile correctional facilities or state and federal prisons and return home each year--a process that we call youth reentry. The unprecedented growth in incarceration means that communities across the country increasingly must confront the challenges of integrating ever-growing numbers of young people who have been in adult prisons or prison-like settings operated by the juvenile justice system. Youth may face numerous obstacles, including family dysfunction, poverty, drug abuse, and inadequate education, treatment, and services, all of which may not only contribute to criminal behavior but also to their success during reentry in avoiding crime and becoming a contributing member of society. This report, which summarizes the insights of participants in the Urban Institute's Youth Reentry Roundtable, examines these issues and provides policy and research recommendations.",
                "authors": {
                    "total": 2,
                    "data": [
                        {
                            "display_name": "Daniel P. Mears",
                            "full_slug": null
                        },
                        {
                            "display_name": "Jeremy Travis",
                            "full_slug": null
                        }
                    ]
                },
                "affiliations": {
                    "total": 0,
                    "data": []
                },
                "is_fulltext_request_allowed": false,
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "Approximately 200,000 youth reenter society annually after incarceration, facing obstacles like family dysfunction, poverty, and inadequate services, which can hinder successful reintegration and contribute to recidivism, highlighting the need for policy and research recommendations.",
                "podcast": null,
                "podcast_generation_allowed": true,
                "entity_type": "PAPER",
                "rank": 4,
                "relevance_data": {},
                "source": "scispace",
                "relevance_summary": "Uses youth reentry data to examine formerly incarcerated young people, noting education gaps and entry pathways; lacks focus on inmate rights, advocacy, or mental\u2011health outcomes.",

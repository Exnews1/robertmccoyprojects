        {
            "papers_Knp69H": {
                "id": 2899171945,
                "title": "2018-6 Dynamics of Deterrence: A Macroeconomic Perspective on Punitive Justice Policy",
                "is_archived": false,
                "full_slug": "2018-6-dynamics-of-deterrence-a-macroeconomic-perspective-on-4aj2fsr6q5",
                "journal": {
                    "display_name": "Research Papers in Economics",
                    "official_page": "http://www.repec.org/",
                    "issn": null,
                    "alias": [
                        "RePEc",
                        "repec.org",
                        "IDEAS database"
                    ],
                    "id": 3121261024,
                    "slug": "research-papers-in-economics",
                    "unique_id": "1xma2naz",
                    "full_slug": "research-papers-in-economics-1xma2naz"
                },
                "conference_series": null,
                "date": "2018-01-01 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Posted Content",
                "doi": null,
                "unique_id": "4aj2fsr6q5",
                "abstract": "We argue that transitional dynamics play a critical role in the evaluation of punitive incarceration reform on crime, inequality and the macroeconomy. Individuals\u2019 past choices related to crime and employment under old policies have persistent consequences that limit their future responses to policy changes. Novel cohort evidence is provided in support of this mechanism. A quantitative model of this theory calibrated using restricted administrative data predicts nuanced, non-monotone dynamics of crime and incarceration similar to the U.S. experience following a single permanent increase in punitive incarceration in the 1980s. Increased inequality and declining employment accompany these changes and are borne unequally across generations.",
                "authors": {
                    "total": 2,
                    "data": [
                        {
                            "display_name": "Bulent Guler",
                            "id": 2234042258,

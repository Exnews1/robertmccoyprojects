        {
            "papers_Knp69H": {
                "id": 2153504871,
                "title": "Psychometric properties of the Coolidge Correctional Inventory in a sample of 3,962 prison inmates.",
                "is_archived": false,
                "full_slug": "psychometric-properties-of-the-coolidge-correctional-3wxx9otxi3",
                "journal": {
                    "display_name": "Behavioral Sciences & The Law",
                    "official_page": "https://onlinelibrary.wiley.com/journal/10990798",
                    "issn": "0735-3936",
                    "alias": [
                        "Behavioral sciences and the law"
                    ],
                    "id": 16292117,
                    "slug": "behavioral-sciences-the-law",
                    "unique_id": "tq0ul5ho",
                    "full_slug": "behavioral-sciences-the-law-tq0ul5ho"
                },
                "conference_series": null,
                "date": "2009-09-01 00:00:00+00:00",
                "is_oa": false,
                "publication_type": "Journal Article",
                "doi": "10.1002/BSL.896",
                "unique_id": "3wxx9otxi3",
                "abstract": "The present study reports on the preliminary psychometric characteristics of a new personality and neuropsychological, 250-item, self-report measure, the Coolidge Correctional Inventory (CCI), in an archival de-identified sample of 3,962 prison inmates. The median internal reliability for the 33 CCI scales and subscales was alpha = .79 (range: alpha = .49 to .93). A prevalence estimate, based on the polythetic criteria in DSM-IV-TR, of at least one personality disorder was 61% of the entire sample, and the prevalence of ADHD was estimated to be 16%. Drug and alcohol problems were also highly prevalent (60%). These results appear to support the preliminary reliability and validity of the CCI and also reveal a high rate of psychopathology and neuropsychological dysfunction among prison inmates.",

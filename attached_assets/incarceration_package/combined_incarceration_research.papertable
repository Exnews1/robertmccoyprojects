                ],
                "rank": 5,
                "relevance_data": {},
                "source": "scispace_full_text",
                "relevance_summary": "Uses prison diagnostic data to examine age\u2011related substance use and social support among recently incarcerated women; does not address education, rights, or systematic mental\u2011health service evaluation.",
                "relevance_metadata": {
                    "criteria_judgments": [
                        {
                            "criterion_name": "Incarcerated Population Focus",
                            "relevance": "Perfectly Relevant"
                        },
                        {
                            "criterion_name": "Educational Attainment of Prisoners",
                            "relevance": "Not Relevant"
                        },
                        {
                            "criterion_name": "Age at Incarceration Entry and Pathways",
                            "relevance": "Highly Relevant"
                        },
                        {
                            "criterion_name": "Prisoner Rights, Voice, and Advocacy",
                            "relevance": "Not Relevant"

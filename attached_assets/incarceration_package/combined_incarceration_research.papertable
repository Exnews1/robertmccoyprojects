        {
            "papers_Knp69H": {
                "id": 2499823762,
                "title": "Meeting Them Where They Are: Student Learning Behind Bars",
                "is_archived": false,
                "full_slug": "meeting-them-where-they-are-student-learning-behind-bars-29xxah15lr",
                "journal": null,
                "conference_series": null,
                "date": "2015-01-01 00:00:00+00:00",
                "is_oa": false,
                "publication_type": "Book Chapter",
                "doi": "10.4018/978-1-4666-8481-2.CH006",
                "unique_id": "29xxah15lr",
                "abstract": "Correctional educational programs strive to enhance the type of prisoner returning to the community and reduce the chances they will return to their criminal activity and (as a result) return to prison. While some correctional facilities have school districts, some collaborate with community colleges to obtain educational services. In 2007, the United States Congress passed the Second Chance Act, which allotted funding to enhance the nation\u2019s educational system within its correctional facilities. The purpose of this chapter is to address a specific way community colleges serve students where they are. The authors address research pertaining to the role of education in an incarcerated student population\u2019s ability to be rehabilitated and reintegrated into society. Additionally, the authors share first-hand curricular and support challenges and innovative practices in preparing students behind bars for the workforce of the (in most cases) not so near future.",
                "authors": {
                    "total": 2,

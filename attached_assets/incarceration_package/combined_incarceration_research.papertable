        {
            "papers_Knp69H": {
                "id": 4049949631,
                "title": "Gefangen und rechtlos? Ein neues Verst\u00e4ndnis vom Zugang zum Recht f\u00fcr Gefangene",
                "is_archived": false,
                "full_slug": "gefangen-und-rechtlos-ein-neues-verstandnis-vom-zugang-zum-3gi1kdfmznw4",
                "journal": {
                    "display_name": "Neue Kriminalpolitik",
                    "official_page": null,
                    "issn": "0934-9200",
                    "alias": [
                        "NK"
                    ],
                    "id": 4000069034,
                    "slug": "neue-kriminalpolitik",
                    "unique_id": "3n1nl62a",
                    "full_slug": "neue-kriminalpolitik-3n1nl62a"
                },
                "conference_series": null,
                "date": "2024-01-01 00:00:00+00:00",
                "is_oa": null,
                "publication_type": "Journal Article",
                "doi": "10.5771/0934-9200-2024-4-432",
                "unique_id": "3gi1kdfmznw4",
                "abstract": "Damit der Zugang zum Recht kein leeres Versprechen bleibt, bedarf es eines mehrdimensionalen Verst\u00e4ndnisses, das die Gefangenen und ihre Menschenrechte in den Mittelpunkt stellt. In diesem Beitrag werden vier Dimensionen vorgeschlagen, die hierf\u00fcr als Orientierung dienen k\u00f6nnen. Ziel des Beitrags ist es, zu einem besseren Verst\u00e4ndnis des Zugangs von Gefangenen zum Recht beizutragen und dieses f\u00fcr die empirische Forschung und andere soziale Akteur*innen zug\u00e4nglich zu machen. ",
                "authors": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "David M\u00fchlemann",
                            "full_slug": null
                        }
                    ]
                },
                "affiliations": {
                    "total": 0,
                    "data": []
                },
                "is_fulltext_request_allowed": false,
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "This paper proposes a four-dimensional understanding of prisoners' access to justice, prioritizing their human rights, to ensure a meaningful right to legal recourse, contributing to improved empirical research and social practice.",
                "podcast": null,
                "podcast_generation_allowed": false,
                "entity_type": "PAPER",
                "rank": 20,
                "relevance_data": {},
                "source": "scispace",
                "relevance_summary": "Uses a multidimensional framework to place prisoners' legal rights at the core, directly addressing incarcerated individuals. Does not discuss education levels, entry age, mental health, needs assessments, or cross\u2011jurisdiction comparisons.",

            "papers_Knp69H": {
                "id": 4049946313,
                "title": "Die rechtspolitische Bedeutung des Zugangs zum Recht f\u00fcr Gefangene",
                "is_archived": false,
                "full_slug": "die-rechtspolitische-bedeutung-des-zugangs-zum-recht-fur-72dtelub4e49",
                "journal": {
                    "display_name": "Neue Kriminalpolitik",
                    "official_page": null,
                    "issn": "0934-9200",

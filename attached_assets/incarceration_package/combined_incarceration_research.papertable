            "papers_Knp69H": {
                "id": 2128978011,
                "title": "Pathways to Prison Impact of Victimization in the Lives of Incarcerated Women",
                "is_archived": false,
                "full_slug": "pathways-to-prison-impact-of-victimization-in-the-lives-of-4hbz3yzwzp",
                "journal": {
                    "display_name": "Violence Against Women",
                    "official_page": "http://vaw.sagepub.com/",
                    "issn": "1077-8012",
                    "alias": [
                        "VAW"

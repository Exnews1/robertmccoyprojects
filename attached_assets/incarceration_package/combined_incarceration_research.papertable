                        "total": null
                    }
                },
                "tldr": "Examining the characteristics of effective prison education programs in one state. Findings reveal substantial differences across programs and facilities.",
                "podcast": null,
                "podcast_generation_allowed": true,
                "entity_type": "PAPER",

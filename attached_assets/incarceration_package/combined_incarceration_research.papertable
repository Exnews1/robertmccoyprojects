        {
            "papers_Knp69H": {
                "id": 1989619056,
                "title": "Constructing Citizenship: Making Room for Prisoners' Rights",
                "is_archived": false,
                "full_slug": "constructing-citizenship-making-room-for-prisoners-rights-55l68brxzp",
                "journal": {
                    "display_name": "Journal of Social Welfare and Family Law",
                    "official_page": "https://www.tandfonline.com/toc/rjsf20/current",
                    "issn": "0964-9069",
                    "alias": [
                        "Journal of social welfare and family law"
                    ],
                    "id": 193641114,
                    "slug": "journal-of-social-welfare-and-family-law",
                    "unique_id": "2oktprhm",
                    "full_slug": "journal-of-social-welfare-and-family-law-2oktprhm"
                },
                "conference_series": null,
                "date": "2008-11-27 00:00:00+00:00",
                "is_oa": false,
                "publication_type": "Journal Article",
                "doi": "10.1080/09649060802469827",
                "unique_id": "55l68brxzp",
                "abstract": "This article examines the impact of prisoners' rights in the UK and the US in relation to the shift in prisoners' status from a state of social and civil death towards a recognition of their citizenship that is grounded in social inclusion. It argues that the concept of citizenship can be reconstructed to include prisoners and that a rights\u2010based approach is crucial in moving the prisoner from the status of a non\u2010person, who is socially dead, towards citizenship. Only such a reconstruction will lead to improvements in the treatment of prisoners and to the raising of standards in prison; alternative methods, including new managerialist strategies, have failed to achieve significant improvements.",
                "authors": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "Susan Easton",
                            "id": 2109013499,
                            "slug": "susan-easton",

            "papers_Knp69H": {
                "id": 2310501934,
                "title": "Substance-Abusing Female Offenders as Victims: Chronological Sequencing of Pathways Into the Criminal Justice System",
                "is_archived": false,
                "full_slug": "substance-abusing-female-offenders-as-victims-chronological-m4m31br6gk",
                "journal": {
                    "display_name": "Victims & Offenders",
                    "official_page": "https://www.tandfonline.com/toc/uvao20/current",
                    "issn": "1556-4886",
                    "alias": [
                        "Victims and offenders"
                    ],
                    "id": 162262202,
                    "slug": "victims-offenders",
                    "unique_id": "r0q3301a",
                    "full_slug": "victims-offenders-r0q3301a"
                },
                "conference_series": null,
                "date": "2017-01-01 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Journal Article",
                "doi": "10.1080/15564886.2015.1017131",
                "unique_id": "m4m31br6gk",
                "abstract": "This study assesses the entrance of substance-abusing female offenders (N=1,209) into the criminal justice system through temporal patterns (using age of first victimization, drug use and arrest). Nine pathways were identified. Unexpectedly, the leading path was a sequence where drug use preceded arrest in absence of childhood victimization. However, women under a path inclusive of victimization possessed more risk factors. Findings support feminist pathway research, which states that childhood victimization is generally present in female offenders' lives. Nevertheless, results also revealed that a drug pathway without childhood abuse proved to be as important and even more dominant among criminal justice-involved women.",
                "authors": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "Vivian C. Smith",
                            "id": 2496829986,
                            "slug": "vivian-c-smith",
                            "unique_id": "2l81fcx2fd",
                            "full_slug": "vivian-c-smith-2l81fcx2fd",
                            "affiliation_full_slug": "cabrini-college-1kfcnkrg"
                        }
                    ]

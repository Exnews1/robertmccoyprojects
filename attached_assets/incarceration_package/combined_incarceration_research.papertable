        {
            "papers_Knp69H": {
                "id": 4006646064,
                "title": "Experiences of Learners Who Are Incarcerated With Accessing Educational Opportunities in Ontario, Canada",
                "is_archived": false,
                "full_slug": "experiences-of-learners-who-are-incarcerated-with-accessing-64x1vyl0",
                "journal": {
                    "display_name": "Journal of Higher Education, Theory, and Practice",
                    "official_page": null,
                    "issn": "2158-3595",
                    "alias": [
                        "JHETP"
                    ],
                    "id": 2764639769,
                    "slug": "journal-of-higher-education-theory-and-practice",
                    "unique_id": "10zibhsu",
                    "full_slug": "journal-of-higher-education-theory-and-practice-10zibhsu"
                },
                "conference_series": null,
                "date": "2023-01-31 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Journal Article",
                "doi": "10.33423/jhetp.v23i1.5790",
                "unique_id": "64x1vyl0",
                "abstract": "Access to education is a human right that should be upheld for everyone including individuals who are incarcerated as outlined in Article 26 of the United Nations Universal Declaration of Human Rights. 25 interviews were conducted between April to June 2021 with various key stakeholders: 5 staff involved with the delivery of educational programs in jails, 10 learners who are or were formerly incarcerated, and 10 representatives from post-secondary institutions or jails. The objective was to identify barriers limiting access to education, while incarcerated and post-release, and how such barriers can be mitigated. Responses were examined using Critical Race Theory as a paradigm and thematic analysis as a methodology. Findings indicate that access to education for individuals who are incarcerated remains limited, not prioritized, and overall an underdeveloped sector in Canada. More funding and resources need to be allocated to prioritize education and expand the capacity of incarceration facilities to offer more programming in ways that are accessible and socio-culturally relevant. ",
                "fulltext_url": "/pdf/experiences-of-learners-who-are-incarcerated-with-accessing-64x1vyl0.pdf",
                "fulltext_url_no_follow": false,
                "is_fulltext_request_allowed": false,
                "paper_urls": {

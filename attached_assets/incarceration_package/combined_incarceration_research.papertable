        {
            "papers_Knp69H": {
                "id": 4056780129,
                "title": "Pathways to Prison: Life Histories of Former Clients of the Child Welfare and Juvenile Justice Systems",
                "is_archived": false,
                "full_slug": "pathways-to-prison-life-histories-of-former-clients-of-the-peq5g83dmof4",
                "journal": null,

        {
            "papers_Knp69H": {
                "id": 2606561095,
                "title": "Human Rights in English Prisons: Prisoners\u2019 Views",
                "is_archived": false,
                "full_slug": "human-rights-in-english-prisons-prisoners-views-3hk1q195cu",
                "journal": null,
                "conference_series": null,
                "date": "2017-01-01 00:00:00+00:00",
                "is_oa": false,
                "publication_type": "Book Chapter",
                "doi": "10.1057/978-1-137-58502-8_5",
                "unique_id": "3hk1q195cu",
                "abstract": "Fieldwork on English prisoners\u2019 views on human rights in prison highlights the inextricable link between human rights and the legitimacy of prison as punishment. Human rights recognition and protection normalise the prison environment and allow for rehabilitation opportunities to flourish, empowering and supporting prisoners in their resettlement efforts. Informed by human rights principles, English prisoners built a picture of prison as a place that can facilitate personal empowerment, independence and autonomy in order to prepare prisoners for their release and increase their reintegration prospects.",

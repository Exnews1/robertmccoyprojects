            "papers_Knp69H": {
                "id": 4037248215,
                "title": "Beliefs about Higher Education for Incarcerated People Through the Lens of Public Health Prevention",
                "is_archived": false,
                "full_slug": "beliefs-about-higher-education-for-incarcerated-people-jqj0n5453w",
                "journal": {
                    "display_name": "Dialogues in social justice",
                    "official_page": null,
                    "issn": "2578-2029",
                    "alias": null,
                    "id": 4000222289,
                    "slug": "dialogues-in-social-justice",
                    "unique_id": "10kll5uahj",
                    "full_slug": "dialogues-in-social-justice-10kll5uahj"
                },
                "conference_series": null,
                "date": "2023-04-03 00:00:00+00:00",
                "is_oa": null,
                "publication_type": "Journal Article",
                "doi": "10.55370/dsj.v8i1.1292",
                "unique_id": "jqj0n5453w",
                "abstract": "Incarcerated individuals are one of the most educationally disadvantaged populations in U.S. Limited education is a risk factor for initial incarceration and recidivism. Despite robust empirical findings supporting post-secondary correctional education (PSCE) as an evidence-based intervention that reduces crime, some individuals are reluctant to support their adoption more widely. An opinion piece in the New York Times suggesting that prisons be turned into colleges provides an opportunity to better understand public opinion regarding PSCE programs through the lens of public health prevention. Although, many readers were supportive of PSCE\u2019s as a means to prevent recidivism, many questioned if the target population was capable of completing college level work, if these programs would incentivize criminal behavior and felt prisoners are not deserving of the opportunity to take college courses, especially as student debt and college costs are rising. Lastly, potential implications and recommendations for policymakers and higher education leaders are discussed. ",
                "authors": {
                    "total": 2,
                    "data": [
                        {
                            "display_name": "Holly Harner",
                            "full_slug": null
                        },
                        {
                            "display_name": "Brian R. Wyant",
                            "full_slug": null
                        }
                    ]
                },
                "affiliations": {
                    "total": 0,
                    "data": []
                },
                "is_fulltext_request_allowed": false,
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "Incarcerated individuals face limited educational opportunities, which increases recidivism risk. PSCE programs have been shown to reduce crime, but public opinion remains divided on their implementation. Concerns include the ability of the target population to complete college-level work, potential incentives for criminal behavior, and feelings of undeservingness.",
                "podcast": null,
                "podcast_generation_allowed": true,
                "entity_type": "PAPER",
                "rank": 13,
                "relevance_data": {},
                "source": "scispace",
                "relevance_summary": "Uses public opinion on college programs to explore attitudes toward incarcerated learners; lacks direct data on prisoners' education levels, age of entry, mental health, or systematic needs assessments.",

        {
            "papers_Knp69H": {
                "id": 1686708763,
                "title": "Toward a Demographic Understanding of Incarceration Disparities: Race, Ethnicity, and Age Structure",
                "is_archived": false,
                "full_slug": "toward-a-demographic-understanding-of-incarceration-4uq3ib9jnf",
                "journal": {
                    "display_name": "Journal of Quantitative Criminology",
                    "official_page": "https://www.springer.com/journal/10940",
                    "issn": "0748-4518",
                    "alias": null,
                    "id": 25809236,
                    "slug": "journal-of-quantitative-criminology",
                    "unique_id": "thlnmata",
                    "full_slug": "journal-of-quantitative-criminology-thlnmata"
                },
                "conference_series": null,
                "date": "2016-12-01 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Journal Article",
                "doi": "10.1007/S10940-015-9265-6",
                "unique_id": "4uq3ib9jnf",
                "abstract": "Objectives Non-Hispanic blacks and Hispanics in the United States are more likely to be incarcerated than non-Hispanic whites. The risk of incarceration also varies with age, and there are striking differences in age distributions across racial/ethnic groups. Guided by these trends, the present study examines the extent to which differences in age structure account for incarceration disparities across racial and ethnic groups. Methods We apply two techniques commonly employed in the field of demography, age-standardization and decomposition, to data provided by the Bureau of Justice Statistics and the 2010 decennial census to assess the contribution of age structure to racial and ethnic disparities in incarceration. Findings The non-Hispanic black and Hispanic incarceration rates in 2010 would have been 13\u201320 % lower if these groups had age structures identical to that of the non-Hispanic white population. Moreover, age structure accounts for 20 % of the Hispanic/white disparity and 8 % of the black/white disparity. Conclusion The comparison of crude incarceration rates across racial/ethnic groups may not be ideal because these groups boast strikingly different age structures. Since the risk of imprisonment is tied to age, criminologists should consider adjusting for age structure when comparing rates of incarceration across groups.",
                "authors": {
                    "total": 3,
                    "data": [
                        {
                            "display_name": "Matt Vogel",
                            "id": 2611152606,
                            "slug": "matt-vogel",

            "papers_Knp69H": {
                "id": 4070846097,
                "title": "Los derechos humanos de las personas privadas de libertad [The human rights of persons deprived of liberty]",
                "is_archived": false,
                "full_slug": "los-derechos-humanos-de-las-personas-privadas-de-libertad-ib0dz1icgvvh",
                "journal": {
                    "display_name": "Verdad y Derecho.\u00a0Revista Arbitrada de Ciencias Jur\u00eddicas y Sociales.",
                    "official_page": "https://revistasinstitutoperspectivasglobales.org/index.php/verdadyderecho",
                    "issn": "3028-872X",
                    "alias": [
                        "Verdad y Derecho.\u00a0Revista Arbitrada de Ciencias Jur\u00eddicas y Sociales"
                    ],
                    "id": 4000228793,
                    "slug": "verdad-y-derecho-revista-arbitrada-de-ciencias-juridicas-y",
                    "unique_id": "2e952eqt116g",
                    "full_slug": "verdad-y-derecho-revista-arbitrada-de-ciencias-juridicas-y-2e952eqt116g"
                },
                "conference_series": null,
                "date": "2024-11-21 00:00:00+00:00",
                "is_oa": null,
                "publication_type": "Journal Article",
                "doi": "10.62574/0vx18w67",
                "unique_id": "ib0dz1icgvvh",
                "abstract": "El art\u00edculo tiene por objetivo analizar los derechos humanos de las personas privadas de libertad. Mediante un enfoque cualitativo documental-bibliogr\u00e1fico, se examinan 16 publicaciones acad\u00e9micas recientes (2020-2023) que abordan esta problem\u00e1tica desde perspectivas jur\u00eddicas, sociol\u00f3gicas y de pol\u00edtica p\u00fablica. Los resultados revelan una brecha significativa entre el marco normativo garantista y la realidad carcelaria, caracterizada por sobrepoblaci\u00f3n, violencia institucional e ineficacia de los programas de rehabilitaci\u00f3n. Se identifican los principales factores que vulneran los derechos de las PPL y se eval\u00faan los mecanismos jur\u00eddicos de protecci\u00f3n disponibles, como el h\u00e1beas corpus. Se concluye que es imperativo adoptar un enfoque integral que transforme la gesti\u00f3n penitenciaria y fortalezca los mecanismos de protecci\u00f3n para garantizar condiciones de vida digna y procesos efectivos de rehabilitaci\u00f3n y reinserci\u00f3n social. ",
                "authors": {
                    "total": 4,
                    "data": [
                        {
                            "display_name": "Geovanny Leopoldo Borja-Mart\u00ednez",

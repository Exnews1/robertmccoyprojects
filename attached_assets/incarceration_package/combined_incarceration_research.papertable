        {
            "papers_Knp69H": {
                "id": 1582983358,
                "title": "The Wages of Prison Overcrowding: Harmful Psychological Consequences and Dysfunctional Correctional Reactions",
                "is_archived": false,
                "full_slug": "the-wages-of-prison-overcrowding-harmful-psychological-1mi8vgbe1w",
                "journal": {
                    "display_name": "Washington University Journal of Law and Policy",
                    "official_page": "http://books.google.com/books?id=BsJUAAAAMAAJ",
                    "issn": "1533-4686",
                    "alias": [
                        "Wash. U.J.L. & Pol'y",
                        "Washington University journal of law & policy"
                    ],
                    "id": 2764531699,
                    "slug": "washington-university-journal-of-law-and-policy",
                    "unique_id": "1rw4catu",
                    "full_slug": "washington-university-journal-of-law-and-policy-1rw4catu"
                },
                "conference_series": null,
                "date": "2006-01-01 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Journal Article",
                "doi": null,
                "unique_id": "1mi8vgbe1w",
                "abstract": "At the outset of this brief article I want to make three preliminary, clarifying points. The first is that we now fully understand\u2014in psychology and related disciplines\u2014that powerful social contexts like prisons can shape and transform the people who enter them. When prison environments become unduly painful they also become harmful, and prisoners carry the effects or consequences of that harm back into the \u201cfreeworld\u201d once they have been released. Thus, bad prisons are not only unpleasant or uncomfortable; they can be destructive as well. It is ironic and instructive that the debate over the psychological effects of imprisonment virtually always revolves around how much harm is inflicted rather than how much benefit is produced. Even proponents of the prison status quo seem relieved to learn that prisons do not harm literally everyone confined in them. For example, prison expert Frank Porporino summarized some of the literature on prison effects stating: \u201cthe evidence indicates that imprisonment is not generally or uniformly devastating . . . . Imprisonment, in and of itself, does not seem inevitably to damage individuals.\u201d Nonetheless,",
                "authors": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "Craig Haney",
                            "id": 2689083096,
                            "slug": "craig-haney",
                            "unique_id": "1esna54sgv",
                            "full_slug": "craig-haney-1esna54sgv"
                        }
                    ]
                },
                "affiliations": {
                    "total": 0,
                    "data": []
                },
                "fulltext_url": "/pdf/the-wages-of-prison-overcrowding-harmful-psychological-1mi8vgbe1w.pdf",
                "fulltext_url_no_follow": false,
                "is_fulltext_request_allowed": false,

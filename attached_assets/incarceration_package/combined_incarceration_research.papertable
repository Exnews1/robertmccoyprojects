                "rank": 18,
                "relevance_data": {},
                "source": "scispace_full_text",
                "relevance_summary": "Uses prison mental\u2011health screening failures to highlight rights gaps; calls for systematic re\u2011evaluation and better care for incarcerated individuals.",
                "relevance_metadata": {

        {
            "papers_Knp69H": {
                "id": 4060908768,
                "title": "Academic Achievement and the Implications for Prison Program Effectiveness and Reentry",
                "is_archived": false,
                "full_slug": "academic-achievement-and-the-implications-for-prison-program-qz1xh9johliz",
                "journal": null,
                "conference_series": null,
                "date": null,
                "is_oa": null,
                "publication_type": null,
                "doi": "10.1177/0093854820919790",
                "unique_id": "qz1xh9johliz",
                "abstract": "The current study examines how academic achievement\u2014measured as verbal and math performance\u2014is associated with prison programming and reentry. We assess how academic achievement might be directly associated with recidivism and whether this occurs indirectly by moderating the effectiveness of in-prison programs. Using a statewide subsample of incarcerated individuals (N = 13,536), the results illustrated that academic achievement directly and indirectly affected the likelihood of recidivism. Lower academic achievement was associated with a higher likelihood of recidivism immediately upon reentry, but was also linked to greater effectiveness of prison programs aimed at reducing recidivism. The reduction in the likelihood of reincarceration associated with program participation was greater for individuals with lower academic achievement compared with those with higher academic achievement. The results underscore how individual differences can lead to heterogeneous outcomes and emphasize the need to target those individuals most likely to struggle with the practical barriers of reentry.",
                "authors": {
                    "total": 4,
                    "data": [
                        {
                            "display_name": "Ian A. Silver",
                            "full_slug": null
                        },
                        {
                            "display_name": "Joshua C. Cochran",
                            "full_slug": null
                        },
                        {
                            "display_name": "Ryan T. Motz",
                            "full_slug": null
                        },
                        {
                            "display_name": "Joseph L. Nedelec",
                            "full_slug": null
                        }
                    ]
                },
                "affiliations": {
                    "total": 0,
                    "data": []
                },
                "is_fulltext_request_allowed": false,
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "This study examines the relationship between academic achievement and prison program effectiveness, finding that lower academic achievement is associated with higher recidivism rates, but also greater effectiveness of programs aimed at reducing recidivism, particularly for those with lower achievement.",
                "podcast": null,
                "podcast_generation_allowed": true,
                "entity_type": "PAPER",
                "rank": 21,
                "relevance_data": {},
                "source": "scispace",
                "relevance_summary": "Uses statewide inmate sample to link academic achievement with recidivism and program impact; directly measures education levels, but omits age entry, rights, mental health, and cross\u2011jurisdiction comparisons.",

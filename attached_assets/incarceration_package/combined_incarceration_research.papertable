                "tldr": "In this paper, it is argued that the lack of formal education programs for individuals on remand in Ontario is a violation of their right to education and therefore, their human rights.",
                "podcast": null,
                "podcast_generation_allowed": true,
                "entity_type": "PAPER",
                "rank": 3,
                "relevance_data": {},
                "source": "scispace",
                "relevance_summary": "Uses human\u2011rights framework to argue education denial for remand detainees, offers policy recommendations, but lacks data on attainment levels, age\u2011of\u2011entry, or mental\u2011health aspects.",
                "relevance_metadata": {
                    "criteria_judgments": [
                        {
                            "criterion_name": "Incarcerated Population Focus",
                            "relevance": "Perfectly Relevant"
                        },
                        {
                            "criterion_name": "Educational Attainment of Prisoners",
                            "relevance": "Somewhat Relevant"
                        },
                        {
                            "criterion_name": "Age at Incarceration Entry and Pathways",
                            "relevance": "Not Relevant"
                        },
                        {
                            "criterion_name": "Prisoner Rights, Voice, and Advocacy",
                            "relevance": "Highly Relevant"

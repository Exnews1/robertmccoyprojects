        {
            "papers_Knp69H": {
                "id": 1996487367,
                "title": "Mental Health Status of Prisoners in an Urban Jail",
                "is_archived": false,
                "full_slug": "mental-health-status-of-prisoners-in-an-urban-jail-4f1781osex",
                "journal": {
                    "display_name": "Criminal Justice and Behavior",
                    "official_page": "http://cjb.sagepub.com/",
                    "issn": "0093-8548",
                    "alias": [
                        "Criminal Justice & Behavior"
                    ],
                    "id": 74425203,
                    "slug": "criminal-justice-and-behavior",
                    "unique_id": "av5miyty",
                    "full_slug": "criminal-justice-and-behavior-av5miyty"
                },
                "conference_series": null,
                "date": "1985-03-01 00:00:00+00:00",
                "is_oa": false,
                "publication_type": "Journal Article",
                "doi": "10.1177/0093854885012001004",
                "unique_id": "4f1781osex",
                "abstract": "The mental health status of a group of 486 admissions to the Philadelphia Prisons was systematically examined in a carefully controlled study using multiple indices of psychopathology. In addition to measures of psychopathology, demographic information and descriptive personality and intelligence data were collected on all subjects. Subsets of subjects also received individual psychiatric interviews and psychological evaluations. The results indicate that approximately two-thirds of the subjects were identifiable by relatively stringent criteria as being psychiatrically disturbed and in need of specific mental health treatment services, and 34% were identifiable by all indicators of psychopathology used. Furthermore, 11% were in need of immediate inpatient psychiatric hospital care. Implications for treatment planning in correctional service settings are discussed.",
                "authors": {
                    "total": 4,
                    "data": [
                        {
                            "display_name": "Edward Guy",

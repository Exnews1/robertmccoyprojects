        {
            "papers_Knp69H": {
                "id": 4022496165,
                "title": "Carceral Passages: Coming of Age in Prison America",
                "is_archived": false,
                "full_slug": "carceral-passages-coming-of-age-in-prison-america-3kwvkaze8n",
                "journal": {
                    "display_name": "American Journal of Sociology",
                    "official_page": "http://www.journals.uchicago.edu/ajs",
                    "issn": "0002-9602",
                    "alias": [
                        "The American Journal of Sociology",
                        "The American journal of sociology",
                        "Am J Sociol"
                    ],
                    "id": 122471516,
                    "slug": "american-journal-of-sociology",
                    "unique_id": "28mhuzvo",
                    "full_slug": "american-journal-of-sociology-28mhuzvo"
                },
                "conference_series": null,
                "date": "2024-02-01 00:00:00+00:00",
                "is_oa": null,
                "publication_type": "Journal Article",
                "doi": "10.1086/729769",
                "unique_id": "3kwvkaze8n",
                "abstract": "Imprisonment is recognized as routine in the lives of disadvantaged young men. Scholars center the impact of relatively brief prison experiences on postprison early adulthood, but this approach overlooks the many who are imprisoned for long periods. This study addresses this concern by analyzing interviews with African American and Afro-Latino men who were sentenced as youth and early adults to long prison terms. Prison-like conditions pervaded men\u2019s life histories in ways that shaped how they made sense of incarceration and early adulthood. While those who cycled in and out of penal institutions or who entered prison later in life saw imprisonment as an unsalvageable condition, those incarcerated throughout their early adult years drew on alternate frames of reference to make strategic use of their time and to construct a sense of incarcerated adulthood. The study conceptualizes these coming-of-age processes as carceral passages\u2014repeated encounters with confinement, criminalization, and violence starting at very young ages.",
                "authors": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "David Jonathan Knight",
                            "full_slug": null
                        }
                    ]
                },
                "affiliations": {
                    "total": 0,
                    "data": []
                },
                "is_fulltext_request_allowed": false,
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "Carceral passages shape coming-of-age experiences for young men imprisoned for long periods, influencing their sense of incarcerated adulthood and strategic use of time.",
                "podcast": null,
                "podcast_generation_allowed": true,
                "entity_type": "PAPER",
                "rank": 1,
                "relevance_data": {},
                "source": "scispace",
                "relevance_summary": "Uses in\u2011depth interviews with long\u2011term incarcerated men to explore how early\u2011life sentencing shapes adult identity; does not address education, mental health, or systematic needs assessments, and only indirectly touches on prisoner voice.",
                "relevance_metadata": {

                        },
                        {
                            "display_name": "Emma Woods",
                            "full_slug": null
                        },
                        {
                            "display_name": "Kimberlie Dean",
                            "full_slug": null
                        }
                    ]
                },
                "affiliations": {
                    "total": 0,
                    "data": []
                },
                "is_fulltext_request_allowed": false,
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "A total population sample of 9568 prison entrants in New South Wales, Australia, showed high prevalence of mental health conditions (62%), self-harm (14%), and suicide attempts (12%), with women and First Nations people at higher risk.",
                "podcast": null,

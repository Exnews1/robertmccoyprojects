        {
            "papers_Knp69H": {
                "id": 4018369084,
                "title": "The Mental Health of Prisoners",
                "is_archived": false,
                "full_slug": "the-mental-health-of-prisoners-1j0889qy",
                "journal": null,
                "conference_series": null,
                "date": "2023-07-01 00:00:00+00:00",
                "is_oa": false,
                "publication_type": "Book Chapter",
                "doi": "10.1093/med/9780197521359.003.0033",
                "unique_id": "1j0889qy",
                "abstract": "Abstract Prisons have for centuries been the backbone of penal systems internationally, with more than 90% of inmates being men. Incarceration rates differ significantly and are highest among underprivileged and minority groups. The United States has the highest overall incarceration rate. Mental health problems are more prevalent in prisons than outside, with increased rates of major depression and psychosis. Those with mental illness also have significant impairment in other areas of social functioning, and female prisoners have very high levels of mental illness. Substance misuse is a significant problem in prisons, and again prevalence is higher than in the general population. The first weeks of incarceration are especially risky as regards suicidal behavior. Certain groups require special attention, such as prisoners on remand, adolescents, women, older people, and LGBT+ prisoners. Evidence is emerging that interventions may reduce reoffending rates and improve the health of prisoners, but there is no consistency of approach within or between individual countries. Prison is still used primarily as punishment, with rehabilitation playing a smaller part or being absent altogether even though the United Nations states that prisoners should have the same access to healthcare as if they were in the general community. ",
                "is_fulltext_request_allowed": false,
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "The United States has the highest overall incarceration rate and mental health problems are more prevalent in prisons than outside, with increased rates of major depression and psychosis, and female prisoners have very high levels of mental illness as discussed by the authors .",
                "podcast": null,
                "podcast_generation_allowed": true,
                "entity_type": "PAPER",
                "rank": 11,
                "relevance_data": {},
                "source": "scispace",

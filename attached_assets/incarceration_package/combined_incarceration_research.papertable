        {
            "papers_Knp69H": {
                "id": 2037915138,
                "title": "Mental health in prisons: A public health agenda.",
                "is_archived": false,
                "full_slug": "mental-health-in-prisons-a-public-health-agenda-1bwk0jc81e",
                "journal": {
                    "display_name": "International Journal of Prisoner Health",
                    "official_page": null,
                    "issn": "1744-9200",
                    "alias": null,
                    "id": 147041160,
                    "slug": "international-journal-of-prisoner-health",
                    "unique_id": "3t7epkok",
                    "full_slug": "international-journal-of-prisoner-health-3t7epkok"
                },
                "conference_series": null,
                "date": "2009-01-01 00:00:00+00:00",
                "is_oa": false,
                "publication_type": "Journal Article",
                "doi": "10.1080/17449200903115789",
                "unique_id": "1bwk0jc81e",
                "abstract": "Mental illness affects the majority of prisoners. Mental health issues are beginning to take a central position in the development of prison health services, reflecting this burden of disease. This change in focus is not before time. But prison mental health services cannot exist in isolation. Public health systems should lead provision of care for patients with acute and severe illness. A whole prison approach to health and, specifically, mental health will offer the greatest likelihood that offenders will thrive, benefit from imprisonment, and lead law\u2010abiding lives after release. Public awareness of the scale and commitment of prisons to mental health and illness, and understanding of prisons\u2019 role in society, are necessary developments that would protect and enhance public mental health, as well as creating a healthier and safer society. This article draws on recent reviews, information and statements to set out a public health agenda for mental health in prisons.",
                "authors": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "A. Fraser",
                            "id": 2112118251,
                            "slug": "a-fraser",

        {
            "papers_Knp69H": {
                "id": 1230930869,
                "title": "How Effective Is Correctional Education, and Where Do We Go from Here?",
                "is_archived": false,
                "full_slug": "how-effective-is-correctional-education-and-where-do-we-go-38os6jubl2",
                "journal": null,
                "conference_series": null,
                "date": "2014-01-01 00:00:00+00:00",
                "is_oa": true,
                "publication_type": null,
                "doi": null,
                "unique_id": "38os6jubl2",
                "abstract": "More than two million adults are incarcerated in US prisons, and each year more than 700,000 leave federal and state prisons and return to communities. Unfortunately, within three years, 40 per cent will be reincarcerated. One reason for this is that ex-offenders lack the knowledge, training, and skills to support a successful return to communities. Trying to reduce such high recidivism rates is partly why states devote resources to educating and training individuals in prison. This raises the question of how effective - and cost-effective - correctional education is - an even more salient question given the funding environment states face from the 2008 recession and its continuing aftermath. The RAND team conducted a systematic review of correctional education programs for incarcerated adults and juveniles. This included a meta-analysis on correctional education's effects on recidivism and post-release employment outcomes for incarcerated adults, as well as a synthesis of evidence on programs for juveniles. The study also included a nationwide survey of state correctional education directors to understand how correctional education is provided today and the recession's impact. The authors also compared the direct costs of correctional education with those of reincarceration to put the recidivism findings into a broader context.",
                "authors": {
                    "total": 8,

                },
                "is_fulltext_request_allowed": false,
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "This study examines the relationship between child maltreatment and future offending through the perspectives of imprisoned adults who received services in the child welfare and juvenile justice systems, highlighting differences in pathways to prison between system entrants.",

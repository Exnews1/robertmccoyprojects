                            "unique_id": "2xekfidxie",
                            "full_slug": "jean-a-voelkel-2xekfidxie"
                        }
                    ]
                },
                "affiliations": {
                    "total": 0,
                    "data": []
                },
                "is_fulltext_request_allowed": false,
                "fulltext_url": "https://www.jstor.org/stable/40007558",

        {
            "papers_MKAHdn": {
                "id": 2103330456,
                "title": "Assaults on Prison Officers: Interactional Themes",
                "is_archived": false,
                "full_slug": "assaults-on-prison-officers-interactional-themes-2s89jnmp28",
                "journal": {
                    "display_name": "Justice Quarterly",
                    "official_page": "https://www.tandfonline.com/toc/rjqy20/current",
                    "issn": "0741-8825",
                    "alias": [
                        "JQ"
                    ],
                    "id": 149422333,
                    "slug": "justice-quarterly",
                    "unique_id": "1wk2wh70",
                    "full_slug": "justice-quarterly-1wk2wh70"
                },
                "conference_series": null,
                "date": "1991-06-01 00:00:00+00:00",
                "is_oa": false,
                "publication_type": "Journal Article",
                "doi": "10.1080/07418829100091021",
                "unique_id": "2s89jnmp28",
                "abstract": "Little is known of the circumstances surrounding prison inmates' assaults on correctional officers. To provide a foundation for understanding the meaning of these events, this exploratory study analyzes a sample of 694 official reports of assaultive incidents in a large state prison system over a one-year period. Results of a content analysis suggest that assaultive events occur in relation to a number of interactional themes\u2014unexplained, officer's command, protest, search, inmates' fighting, movement, contraband, restraint, discipline, emotional instability, sexual, intoxication, and medical. The study's findings affirm that prisoners and officers must cooperate in order to negotiate each day with a minimum of disruption. When either party violates salient norms, mutually beneficial interaction patterns may break down and violent interactions may result. Officially reported assaults on staff members may be understood most clearly by considering the authority of officers, the autonomy of prisoners, and pr...",
                "authors": {
                    "total": 1,
                    "data": [

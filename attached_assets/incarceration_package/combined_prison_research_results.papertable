                        },
                        {
                            "criterion_name": "Inmate Rights Violations and Abuse",
                            "relevance": "Not Relevant"
                        },
                        {
                            "criterion_name": "Rehabilitation and Programming",
                            "relevance": "Not Relevant"
                        },
                        {
                            "criterion_name": "Policy and Legal Framework",

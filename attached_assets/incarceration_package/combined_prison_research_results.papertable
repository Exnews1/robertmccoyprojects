        {
            "papers_MKAHdn": {
                "id": 2777719089,
                "title": "Tension, Authority, Rights",
                "is_archived": false,
                "full_slug": "tension-authority-rights-1s2lt2vvie",
                "journal": null,
                "conference_series": null,
                "date": "2017-01-01 00:00:00+00:00",
                "is_oa": false,
                "publication_type": "Book Chapter",
                "doi": "10.1007/978-3-319-63685-6_6",
                "unique_id": "1s2lt2vvie",
                "abstract": "Although inmates may find daily life in prison frustrating\u2014\u201cIt\u2019s always the same, days are all alike\u201d\u2014it seems to be precisely this cadence that brings the stability and predictability which ultimately help to make the experience of prison more endurable. Everything is structured and planned for in order to follow a certain order determined and imposed by the institution (thus largely inhibiting subjects from their autonomy and agency). For someone who is just an observer of this movement, ignorant of its underlying motivations and intentions, the image that transpires of life in prison resembles a wave-like pattern, swaying to an apparently unprompted and natural rhythm. This Chapter presents several moments where this apparent normalcy is put into question, showing how authority must be ensured by the prison staff to avoid the escalation of tension and discord.",
                "authors": {
                    "total": 1,

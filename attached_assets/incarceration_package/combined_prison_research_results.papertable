                "is_fulltext_request_allowed": false,
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "This narrative literature review (1961-2024) examines staff-prisoner relationships in prisons, finding positive interactions foster trust, respect, and compliance, while procedural justice, communication, and shared values are key factors influencing these dynamics and prison outcomes.",
                "podcast": null,
                "podcast_generation_allowed": true,

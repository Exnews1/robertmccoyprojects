                        "Pdf": [
                            "https://repository.lib.fsu.edu/islandora/object/fsu%3A986184/datastream/PDF/view"
                        ]
                    },
                    "is_show": true
                },
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "The US prison system, with a 2018 population of 2,123,100, perpetuates dehumanization through mass incarceration, with high recidivism rates in communities of color, necessitating reform to maintain relevance and reduce recidivism.",
                "podcast": null,
                "podcast_generation_allowed": true,
                "entity_type": "PAPER",

        {
            "papers_MKAHdn": {
                "id": 2795087541,
                "title": "\u201c\u2018That\u2019s a damn good officer any day of the week\u2019: inmates\u2019 perceptions of correctional officers\u201d",
                "is_archived": false,
                "full_slug": "that-s-a-damn-good-officer-any-day-of-the-week-inmates-57npzopidy",
                "journal": {
                    "display_name": "Criminal Justice Studies",
                    "official_page": "https://www.tandfonline.com/toc/gjup20/current",
                    "issn": "1478-601X",
                    "alias": null,
                    "id": 147235218,
                    "slug": "criminal-justice-studies",
                    "unique_id": "1a35yq0l",
                    "full_slug": "criminal-justice-studies-1a35yq0l"
                },
                "conference_series": null,
                "date": "2018-04-03 00:00:00+00:00",
                "is_oa": false,
                "publication_type": "Journal Article",
                "doi": "10.1080/1478601X.2017.1420544",
                "unique_id": "57npzopidy",
                "abstract": "Correctional scholars have suggested that research describing the world of imprisonment can help illuminate some of the consequences of incarceration, specifically how individuals experience incarceration and the ways in which these experiences effect their reentry and reintegration into society. The present study examines the perceptions, daily interactions, and relationships between prison inmates and correctional officers from the perspectives of those who have been incarcerated. Qualitative, in-depth interviews of men released from Texas prisons focus on former inmates\u2019 personal experiences and perceptions toward correctional officers while serving time.",
                "authors": {
                    "total": 3,
                    "data": [
                        {
                            "display_name": "Lynne M. Vieraitis",
                            "id": 2235361910,

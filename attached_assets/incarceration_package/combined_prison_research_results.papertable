        {
            "papers_MKAHdn": {
                "id": 4051329112,
                "title": "Frustrations+of+Daily+Prison+Life+as+a+Reflection+of+Broader+Dehumanization",
                "is_archived": false,
                "full_slug": "frustrations-of-daily-prison-life-as-a-reflection-of-broader-1ezmoffmpzhk",
                "journal": null,
                "conference_series": null,
                "date": "2024-12-10 00:00:00+00:00",
                "is_oa": null,
                "publication_type": "Journal Article",
                "doi": "10.33009/fsu_2830ed38-06e1-4b1c-bb1e-ef0d20fc4760",
                "unique_id": "1ezmoffmpzhk",
                "abstract": "We as a country, here in the United States, utilize incarceration as the go-to form of punishment for virtually all crimes committed. Even our administrative processes utilize imprisonment, whether it is to hold them during the onset of their trial date or in preparation for their transfer to prison. Imprisonment is an \"essential\" and complicated part of modern society, with the U.S. being a leader in this operation of punishment. As of 2018, the U.S. boasted a prison and jail population of 2,123,100 as of 2018, with medium to high risks of recidivism found in all communities, with the lowest being 27% in Asian communities and the highest being 61% in Black communities (Carson, 2021; Maruschak, 2017 - 2018). Given these staggering numbers, it is perhaps our apparent duty to study and modernize our prison system so that its efficiency can maintain relative relevancy. ",
                "fulltext_url": "pdf/frustrations-of-daily-prison-life-as-a-reflection-of-broader-1ezmoffmpzhk.pdf",
                "fulltext_url_no_follow": false,
                "is_fulltext_request_allowed": false,
                "paper_urls": {
                    "order": [
                        "Pdf"
                    ],

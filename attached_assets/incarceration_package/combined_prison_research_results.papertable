        {
            "papers_MKAHdn": {
                "id": 1983651138,
                "title": "A case study of two types of officer\u2010inmate interaction in a correctional establishment*",
                "is_archived": false,
                "full_slug": "a-case-study-of-two-types-of-officer-inmate-interaction-in-a-4k3mhv0x2a",
                "journal": {
                    "display_name": "Symbolic Interaction",
                    "official_page": "http://onlinelibrary.wiley.com/journal/10.1002/(ISSN)1533-8665",
                    "issn": "0195-6086",
                    "alias": null,
                    "id": 57027881,
                    "slug": "symbolic-interaction",
                    "unique_id": "1p0has35",
                    "full_slug": "symbolic-interaction-1p0has35"
                },
                "conference_series": null,
                "date": "1983-03-01 00:00:00+00:00",
                "is_oa": false,
                "publication_type": "Journal Article",
                "doi": "10.1525/SI.1983.6.1.51",
                "unique_id": "4k3mhv0x2a",
                "abstract": "The paper argues that because studies of correctional institutions favor a focus upon inmates rather than a concentration upon the interaction between inmates and officers, it is quite likely that many accounts of prison life are distorted. Therefore, a focus upon this interaction is recommended in order to achieve a fuller and more accurate description of correctional social structure.\r\n\r\n\r\n\r\nAn illustrative case is presented which compares officer interactions with two types of inmates in a minimum security institution in the United States Northeast. These two types of interactions present the bases of order and disorder in a correctional establishment from the perspectives of both officers and inmates.\r\n\r\n\r\n\r\nThe case study is linked to recent correctional literature to propose some generalizations concerning social order in correctional institutions.",
                "authors": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "Florence Kellner Andrews",

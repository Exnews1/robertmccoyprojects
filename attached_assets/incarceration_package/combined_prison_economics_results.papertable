                        }
                    ]
                },
                "affiliations": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "University of Denver",
                            "city": "Denver",
                            "region": "Colorado",
                            "country": "United States",
                            "id": 131651094,
                            "slug": "university-of-denver",

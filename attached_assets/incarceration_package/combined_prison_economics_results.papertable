        {
            "papers_j8QP6r": {
                "id": 37882138,
                "title": "The New Scarlet Letter? Negotiating the U.S. Labor Market with a Criminal Record",
                "is_archived": false,
                "full_slug": "the-new-scarlet-letter-negotiating-the-u-s-labor-market-with-zzrnl7acne",
                "journal": null,
                "conference_series": null,
                "date": "2014-05-23 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Book",
                "doi": null,
                "unique_id": "zzrnl7acne",
                "abstract": "[The author] provides a concise overview of the barriers faced by ex-convicts as they attempt to reenter the US labor market. First, [the author] studies the factors that influence the market's supply and demand sides. Next, [the author] presents an empirical portrait of the inmate population, recently released inmates, and the youth who eventually enter the prison system as young adults. [The author] reviews what is known about how employers use criminal histories in screening job applicants and the empirical research on the effects of a criminal record on labor market outcomes; [the author] then describes programs designed to help inmates enter the labor force that show positive results. [The author] concludes with a set of policy recommendations aimed at addressing the concerns of employers and preparing inmates for the labor force as they exit the prison system.",
                "authors": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "Steven Raphael",
                            "id": 2004816304,
                            "slug": "steven-raphael",
                            "unique_id": "3bn5kh081x",
                            "full_slug": "steven-raphael-3bn5kh081x"
                        }
                    ]
                },

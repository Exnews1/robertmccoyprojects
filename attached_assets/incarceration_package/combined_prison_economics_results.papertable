        {
            "papers_j8QP6r": {
                "id": 3046564957,
                "title": "\u201cOlder\u201d Inmates in Prison: Considering the Tipping Point of Age and Misconduct",
                "is_archived": false,
                "full_slug": "older-inmates-in-prison-considering-the-tipping-point-of-age-2v6p3vt2mp",
                "journal": {
                    "display_name": "Criminology, Criminal Justice, Law & Society",
                    "official_page": "https://ccjls.scholasticahq.com/",
                    "issn": "2332-886X",
                    "alias": [
                        "Criminology, criminal justice, law and society",
                        "CCJLS",
                        "Journal of criminology, criminal justice, law & society"
                    ],
                    "id": 2737719478,
                    "slug": "criminology-criminal-justice-law-society",
                    "unique_id": "9b3dnnix",
                    "full_slug": "criminology-criminal-justice-law-society-9b3dnnix"
                },
                "conference_series": null,
                "date": "2020-08-01 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Journal Article",
                "doi": null,
                "unique_id": "2v6p3vt2mp",
                "abstract": "Sentencing reforms since the 1990s have created an environment in which inmates have been aging in place. This has created challenges for correctional administrators on how to house and manage older offenders in a safe and secure environment. Previous research has found that the likelihood of committing misconduct in prison decreases with age, suggesting elderly inmates are least likely to engage in prison misconduct. Yet, the operationalization of \u201celderly\u201d has varied across studies, failing to provide a general consensus of the onset of being elderly. With this in mind, the purpose of this study was to determine at what age prison misconduct begins to decline using data from the Arkansas Department of Corrections (ADC). A series of binary logistic regressions were conducted on a sample of 4,793 inmates, who had a minimum of two years (730 days) in prison and were released in 2013 and 2014. In the sample of reentering inmates, it was found that misconduct became significantly less likely amongst inmates older than 40 years old. Further, group-specific models demonstrated that correlates significant for predicting misconduct in younger reentering inmates differed from those older than 40 years. By identifying when institutional misconduct decreases, correctional agencies can improve their efficiency in housing, managing, and treating aging inmates.",
                "authors": {
                    "total": 5,
                    "data": [
                        {
                            "display_name": "Rita A. Augustyn",
                            "id": 3046237175,
                            "slug": "rita-a-augustyn",

        {
            "papers_j8QP6r": {
                "id": 2039915612,
                "title": "Allocating Resources Among Prisons And Social Programs In The Battle Against Crime",
                "is_archived": false,
                "full_slug": "allocating-resources-among-prisons-and-social-programs-in-yndb92tfwr",
                "journal": {
                    "display_name": "The Journal of Legal Studies",
                    "official_page": "http://www.journals.uchicago.edu/loi/jls",
                    "issn": "0047-2530",
                    "alias": [
                        "JLS"
                    ],
                    "id": 9231424,
                    "slug": "the-journal-of-legal-studies",
                    "unique_id": "3p2fjdxs",
                    "full_slug": "the-journal-of-legal-studies-3p2fjdxs"
                },
                "conference_series": null,
                "date": "1998-01-01 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Journal Article",
                "doi": "10.1086/468012",
                "unique_id": "yndb92tfwr",
                "abstract": "This article evaluates the cost and crime\u2010reducing potential of prisons and social spending, setting forth the conditions under which a shift in resources from an expanding prison population into social spending would lead to a reduction in total crime. Preschool enrichment programs coupled with family intervention have generated impressive results in reducing crime in a number of different studies. Targeting of resources toward those children most at risk of criminal behavior is necessary to generate cost\u2010effective crime reduction, but this may be difficult to achieve because of political or constitutional constraints. Given precise targeting, and if a broadly implemented preschool program (more enriched than the current Head Start program) could generate half the crime\u2010reduction benefits achieved in the pilot studies, then cutting spending on prisons and using the savings to fund intensive preschool education would reduce crime. The elasticity of crime with respect to incarceration is taken to ...",

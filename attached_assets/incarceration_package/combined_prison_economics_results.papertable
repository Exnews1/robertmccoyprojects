            "demographics_igYX7G": ""
        },
        {
            "papers_j8QP6r": {
                "id": 4042632537,
                "title": "Aging in the Criminal Justice System",
                "is_archived": false,
                "full_slug": "aging-in-the-criminal-justice-system-3z7vbfrg4l",
                "journal": null,
                "conference_series": null,
                "date": "2023-12-18 00:00:00+00:00",
                "is_oa": null,
                "publication_type": "Book Chapter",
                "doi": "10.1093/oxfordhb/9780197549513.013.30",
                "unique_id": "3z7vbfrg4l",
                "abstract": "Abstract Adults aged 65 and older are the fastest growing subpopulation in the United States. Concurrent with general-population aging is a commensurate rise in the number of older adults involved in the criminal justice system, as both offenders and incarcerated individuals. Although older adults commit fewer and less serious crimes than younger adults, the proportion of older inmates continues to increase. This demographic shift precipitates rising costs, primarily associated with health care and end of life. To ensure older inmates\u2019 safety and meet legal requirements, facilities will have to make physical and social accommodations. These improvements, aimed at developing age-competent systems for adults, may also extend to reformation of policy and practices. However, research on older adults and aging within the criminal justice system is notably lacking. Thus, future studies should expand on the understanding of this aging experience, ultimately aiming to improve the aging crisis in U.S. correctional facilities. ",
                "authors": {
                    "total": 2,
                    "data": [
                        {
                            "display_name": "Lindsey E. Wylie",
                            "full_slug": null
                        },
                        {
                            "display_name": "Sarah Hubner",
                            "full_slug": null
                        }
                    ]
                },
                "affiliations": {
                    "total": 0,
                    "data": []
                },
                "is_fulltext_request_allowed": false,
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "Aging adults in the criminal justice system are increasing, presenting challenges due to health care and end-of-life needs. To address these issues, facilities need to make physical and social accommodations. Further research is needed to expand understanding and inform policy changes.",
                "podcast": null,
                "podcast_generation_allowed": true,
                "entity_type": "PAPER",
                "rank": 12,
                "relevance_data": {},
                "source": "scispace",

                "is_fulltext_request_allowed": false,
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "Aging prison populations pose new challenges to the penal system, highlighting the need for structural adjustments to address the specific needs of older inmates, including care, social isolation, and age-appropriate services, prioritizing autonomy and dignity.",

                },
                "tldr": "This study estimates the total net cost of imprisonment and community corrections in Victoria, Australia, considering direct and indirect costs and savings, and compares the costs of different sentence options to inform effective correctional policy and practice.",
                "podcast": null,
                "podcast_generation_allowed": true,
                "entity_type": "PAPER",
                "rank": 13,
                "relevance_data": {},
                "source": "scispace",
                "relevance_summary": "Uses comprehensive cost comparison of imprisonment vs community corrections to inform economics; mentions cost components but lacks detailed expense breakdown, budget statements, demographic cost links, or revenue analysis.",
                "relevance_metadata": {
                    "criteria_judgments": [
                        {
                            "criterion_name": "Economic analysis of incarceration",

        {
            "papers_j8QP6r": {
                "id": 2110069896,
                "title": "Marcando al delincuente: estigmatizaci\u00f3n, castigo y cumplimiento del derecho",
                "is_archived": false,
                "full_slug": "marcando-al-delincuente-estigmatizacion-castigo-y-10471590ru",

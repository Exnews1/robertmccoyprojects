        {
            "papers_j8QP6r": {
                "id": 1998663033,
                "title": "Making economically sound confinement decisions: A response to the zedlewski thesis",
                "is_archived": false,
                "full_slug": "making-economically-sound-confinement-decisions-a-response-55hky5tco0",
                "journal": {
                    "display_name": "American Journal of Criminal Justice",
                    "official_page": "https://www.springer.com/journal/12103",
                    "issn": "1066-2316",
                    "alias": [
                        "Journal of the Southern Criminal Justice Association",
                        "AJCJ"
                    ],
                    "id": 120133624,
                    "slug": "american-journal-of-criminal-justice",
                    "unique_id": "2os8ajo4",
                    "full_slug": "american-journal-of-criminal-justice-2os8ajo4"
                },
                "conference_series": null,
                "date": "1991-03-01 00:00:00+00:00",
                "is_oa": false,
                "publication_type": "Journal Article",
                "doi": "10.1007/BF02885622",
                "unique_id": "55hky5tco0",
                "abstract": "This paper examines the economic costs and benefits of incarceration of criminals, elaborating upon and correcting flaws in Zedlewski\u2019s 1987 claims that incarceration is a cost-minimizing crime prevention strategy. We use Bureau of Justice Statistics data to demonstrate gross errors in Zedlewski\u2019s crude estimates. We find that the costs of incarceration are more than double the benefits in costs of crime avoided. We conclude that the cost-saving incapacitation effects of incarceration do not warrant either the current levels of imprisonment or any future increases.",
                "authors": {
                    "total": 2,
                    "data": [
                        {
                            "display_name": "Peter B. Meyer",
                            "id": 2111196878,
                            "slug": "peter-b-meyer",
                            "unique_id": "4zjsj7ejbv",
                            "full_slug": "peter-b-meyer-4zjsj7ejbv",
                            "affiliation_full_slug": "university-of-louisville-2cb2rw40"

        {
            "papers_j8QP6r": {
                "id": 2906545750,
                "title": "Les d\u00e9tenus \u00e2g\u00e9s et pathologiques : un nouvel enjeu sanitaire et p\u00e9nitentiaire",
                "is_archived": false,
                "full_slug": "les-detenus-ages-et-pathologiques-un-nouvel-enjeu-sanitaire-rv9eshl1qz",

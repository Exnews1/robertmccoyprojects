        {
            "papers_j8QP6r": {
                "id": 2549001694,
                "title": "Paying for your crime: The pay-to-stay jail program in California",
                "is_archived": false,
                "full_slug": "paying-for-your-crime-the-pay-to-stay-jail-program-in-4oqh05r6l4",
                "journal": null,
                "conference_series": null,
                "date": "2015-01-01 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Dissertation",
                "doi": "10.31979/ETD.5DEE-K6U7",
                "unique_id": "4oqh05r6l4",
                "abstract": "Many California cities have recently implemented pay-to-stay jail programs at the local level. Pay-to-stay programs provide a safe and private incarceration experience for those who can afford the nightly fee. This study provides a theoretical analysis of the pay-to-stay jail program in relation to mass incarceration and the ever-expanding prison economy. It examines pay-to-stay programs as a new method of stratified punishment, reproducing race and class oppression within the U.S. penal regime. A case study of the Fremont pay-to-stay program offers insight into the implementation, operation, and application process for inmates seeking segregation from general county jail populations. This study concludes that pay-to-stay creates a two-tiered jail system\u2014separating the deserving from the undeserving\u2014and promotes disproportionate treatment within the criminal justice system.",
                "authors": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "Carla Schultz",

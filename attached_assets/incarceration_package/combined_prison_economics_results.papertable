        {
            "papers_j8QP6r": {
                "unique_id": "rzph2i5s6j",
                "id": 40841180,
                "full_slug": "economic-impacts-of-prison-growth-rzph2i5s6j",
                "title": "Economic impacts of prison growth",
                "abstract": "This report provides an economic overview of the correctional sector as background for the unfolding debate over spending and other policies. It begins with information on the growth in prison populations in public and in private prisons and also briefly explores the economic impacts of prison location. It is not intended a study of the effectiveness of sentencing and other laws, nor of evolving polices aimed at reducing recidivism and prison populations.",

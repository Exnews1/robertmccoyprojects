                    "data": []
                },
                "is_fulltext_request_allowed": false,
                "metrics": {
                    "citations": {
                        "total": null
                    }
                },
                "tldr": "This study examines public spending for corrections in New York (1977-1978), detailing expenditures for prisons, jails, probation, and parole, and evaluating services provided, with recommendations for improved cost accounting and broader penal reforms.",
                "podcast": null,

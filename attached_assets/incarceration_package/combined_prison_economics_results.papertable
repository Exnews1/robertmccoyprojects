        {
            "papers_j8QP6r": {
                "id": 4018694142,
                "title": "The ageing population: needs and problems of the older person in prison",
                "is_archived": false,
                "full_slug": "the-ageing-population-needs-and-problems-of-the-older-person-jracca3d",
                "journal": null,
                "conference_series": null,
                "date": "2022-08-05 00:00:00+00:00",
                "is_oa": false,
                "publication_type": "Other",
                "doi": "10.1002/9781119684107.ch9",
                "unique_id": "jracca3d",
                "abstract": "The worldwide prison population is ageing, due in part to criminal justice policy changes resulting in longer sentences, stringent release conditions and people growing old in prison, and in part due to people being convicted of historic offences when they are old. The health needs of older people in prison are frequently complex, greater than those of community counterparts, and distinct from younger people in prison. Physical inactivity, obesity, and problematic alcohol use are the most common risk factors for ill health in people over 50 in prison, and cardiovascular, musculoskeletal, and respiratory diseases and depression are the most common health problems experienced. The quality of life of older people in prison is frequently adversely affected by age-related sensory, functional, and cognitive impairments, polypharmacy, and multiple symptoms, including persistent pain, breathlessness, dizziness, and incontinence. Safe and effective care of the older person in prison begins with continuity of health information and screening for physical and mental health problems, age-related sensory, functional, or cognitive impairments, and problems such as incontinence, which may not be volunteered. Effective provision for complex needs of the older person in prison requires appropriate accommodation, good communication, and a planned co-ordinated multi-morbidity approach where prison, health, and social care teams work together. High-quality palliative and end-of-life care is essential for those who will die in custody. ",
                "authors": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "Xue Li",
                            "id": 4004824751,
                            "slug": "xue-li",

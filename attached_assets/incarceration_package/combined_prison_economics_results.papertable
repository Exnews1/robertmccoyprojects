                "tldr": "The US prison population is rapidly aging and bringing with it rising costs, and the increased fiscal burden of caring for these inmates has contributed to the rise of private prison contracting, which offer cost savings despite grave concerns about quality.",
                "podcast": null,
                "podcast_generation_allowed": true,
                "entity_type": "PAPER",
                "rank": 6,
                "relevance_data": {},
                "source": "scispace",
                "relevance_summary": "Uses demographic and health trend data to estimate rising inmate medical needs; does not address costs, budgets, or revenue, but links aging population to resource demands.",
                "relevance_metadata": {
                    "criteria_judgments": [
                        {
                            "criterion_name": "Economic analysis of incarceration",

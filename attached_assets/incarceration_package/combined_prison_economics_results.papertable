        {
            "papers_j8QP6r": {
                "id": 2141722258,
                "title": "Understanding Prisons: The New Old Penology",
                "is_archived": false,
                "full_slug": "understanding-prisons-the-new-old-penology-1tawftkji8",
                "journal": {
                    "display_name": "Law and Social Inquiry-journal of The American Bar Foundation",
                    "official_page": "http://onlinelibrary.wiley.com/journal/10.1111/(ISSN)1528-3585",
                    "issn": "0897-6546",
                    "alias": [
                        "Law and social inquiry"
                    ],
                    "id": 129275725,
                    "slug": "law-and-social-inquiry-journal-of-the-american-bar",
                    "unique_id": "18nxc6e0",
                    "full_slug": "law-and-social-inquiry-journal-of-the-american-bar-18nxc6e0"
                },
                "conference_series": null,
                "date": "1991-01-01 00:00:00+00:00",
                "is_oa": false,
                "publication_type": "Journal Article",
                "doi": "10.1111/J.1747-4469.1991.TB00284.X",
                "unique_id": "1tawftkji8",
                "abstract": "At the end of 1989, more than 675,000 Americans were imprisoned. Most studies estimate that the nation's prison population will easily surpass 1,000,000 before the turn of the century; indeed, one study estimates that as early as 1994 it will reach over 1,130,000.1 The country's annual corrections tax bill is now estimated to be in the neighborhood of $20-$25 billion, with most of the money rushing into the construction, renovation, and administration of prisons. At the state level, for example, in 1987 corrections spending nationwide increased by about 10%, surpassing the rate of increase in education spending for the second consecutive year.2",
                "authors": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "John J. Dilulio",

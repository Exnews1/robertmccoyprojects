        {
            "papers_j8QP6r": {
                "unique_id": "4whew8tsfk",
                "id": 2090925525,
                "full_slug": "a-review-of-quality-measures-used-by-state-and-federal-4whew8tsfk",
                "title": "A review of quality measures used by state and federal prisons",
                "abstract": "In response to deficiencies in the delivery of health care in prisons, a number of state correctional systems and the Federal Bureau of Prisons (BOP) have established quality of care monitoring systems. In 2009, the California Department of Corrections and Rehabilitation and the federal receiver overseeing the system asked the RAND Corporation to identify existing indicators of quality performance and to recommend a set of indicators applicable to the prison population. An environmental scan of quality measures being used by other state correctional systems and the BOP found substantial variation in the number and type of measures being used and the underlying data systems used to construct measures. Explicit quality measures were being used, as were measures of disease prevalence and standards.",
                "is_archived": false,
                "publication_type": "Journal Article",

        {
            "papers_j8QP6r": {
                "id": 4005587532,
                "title": "\u201cYou Need Money to Live in Prison\u201d",
                "is_archived": false,
                "full_slug": "you-need-money-to-live-in-prison-195wpyts",
                "journal": {
                    "display_name": "South Atlantic Quarterly",
                    "official_page": "https://read.dukeupress.edu/south-atlantic-quarterly",
                    "issn": "0038-2876",
                    "alias": [
                        "SAQ"
                    ],
                    "id": 161559975,
                    "slug": "south-atlantic-quarterly",
                    "unique_id": "dlksui4f",
                    "full_slug": "south-atlantic-quarterly-dlksui4f"
                },
                "conference_series": null,
                "date": "2022-08-03 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Journal Article",
                "doi": "10.1215/00382876-10066524",
                "unique_id": "195wpyts",
                "abstract": "In the United States, going to jail or prison increasingly comes with a hefty price tag for incarcerated persons. As states continue to cut public spending, individuals are required to cover costs for basic necessities, such as food, health care, and telecommunications. Most have to rely on financial support from friends and family members to make ends meet during incarceration, thus drawing further resources from already vulnerable communities. Based on ethnographic interviews with formerly incarcerated individuals, and on the personal experience of one of the authors with the New York penal system, this article explores the effects of budget cuts and austerity measures on the everyday lives of the incarcerated, as well as the myriad forms of labor that prisoners perform to fill the gaps in institutional commitments.",
                "authors": {
                    "total": 3,
                    "data": [
                        {
                            "display_name": "Tommaso Bardelli",
                            "id": 3114119031,
                            "slug": "tommaso-bardelli",

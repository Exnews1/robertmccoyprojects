        {
            "papers_j8QP6r": {
                "id": 1762517867,
                "title": "The Growth of Older Inmate Populations: How Population Aging Explains Rising Age at Admission",
                "is_archived": false,
                "full_slug": "the-growth-of-older-inmate-populations-how-population-aging-3vf8qc6ukd",
                "journal": {
                    "display_name": "Journals of Gerontology Series B-psychological Sciences and Social Sciences",
                    "official_page": null,
                    "issn": "1079-5014",
                    "alias": [
                        "Psychological sciences and social sciences"
                    ],
                    "id": 23629409,
                    "slug": "journals-of-gerontology-series-b-psychological-sciences-and",
                    "unique_id": "5mqhjt5w",
                    "full_slug": "journals-of-gerontology-series-b-psychological-sciences-and-5mqhjt5w"
                },
                "conference_series": null,
                "date": "2015-08-25 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Journal Article",
                "doi": "10.1093/GERONB/GBV069",
                "unique_id": "3vf8qc6ukd",
                "abstract": "Objectives. Older inmates are the fastest growing segment of the prison population; however, the reasons for this are not well understood. One explanation is that the general population is aging, driving prison age distributions to change. For this article, we study the role of population aging in prison growth by investigating how the baby boom phenomenon of post-World War II has contributed to the growth of older inmate populations. Method. W e identify the impact of population aging using simulation methods that explain prison growth as the combination of criminal justice processes. Results. Overall, we find evidence that population aging has played a significant role in explaining the growth of older inmate populations, in par ticular among inmates aged between 50 and 64\u00a0years, contributing to as much as half of the observed increase in these groups since 2000. Discussion. This finding stands in contrast to the notion that population aging has lit tle explanatory power in describing the growth of prison populations and implies that older inmate groups are more sensitive to compositional changes in the general population. We argue that prediction-based modeling of prison growth should more seriously consider the impacts and consequences of demographic shifts among older prisoner populations.",
                "authors": {
                    "total": 2,
                    "data": [
                        {
                            "display_name": "Jeremy Luallen",
                            "id": 2149007345,
                            "slug": "jeremy-luallen",
                            "unique_id": "50jau5tbcz",
                            "full_slug": "jeremy-luallen-50jau5tbcz"
                        },

                "tldr": "In the last few decades, additional fees have proliferated, such as charges for police transport, case filing, felony surcharges, electronic monitoring, drug testing, and sex offender registration as mentioned in this paper.",
                "podcast": null,
                "podcast_generation_allowed": true,
                "entity_type": "PAPER",
                "rank": 27,
                "relevance_data": {},
                "source": "scispace",
                "relevance_summary": "Uses inmate fees to illustrate revenue-driven incarceration, linking overall system costs to fiscal pressures; lacks detailed cost breakdowns, budget tables, or demographic cost analysis.",
                "relevance_metadata": {
                    "criteria_judgments": [
                        {
                            "criterion_name": "Economic analysis of incarceration",
                            "relevance": "Somewhat Relevant"
                        },
                        {
                            "criterion_name": "Breakdown of prison operational costs",

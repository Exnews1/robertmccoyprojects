                        ],
                        "Pdf": [
                            "http://www.fedcure.org/documents/CRS_FederalPrisonPopulationBuildup_R42937-220113fc.pdf",
                            "https://digital.library.unt.edu/ark:/67531/metadc462245/m1/1/high_res_d/R42937_2013Jan22.pdf"

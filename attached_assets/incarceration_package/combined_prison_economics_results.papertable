            "papers_j8QP6r": {
                "id": 2884349396,
                "title": "Convict Labor and the Costs of Colonial Infrastructure: Evidence from Prisons in British Nigeria, 1920-1938",
                "is_archived": false,
                "full_slug": "convict-labor-and-the-costs-of-colonial-infrastructure-50fxvdpglo",
                "journal": {
                    "display_name": "Social Science Research Network",

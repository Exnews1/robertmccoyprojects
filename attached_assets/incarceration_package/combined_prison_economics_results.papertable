            "papers_j8QP6r": {
                "id": 2047568667,
                "title": "Cell blocks & red ink: mass incarceration, the great recession & penal reform",
                "is_archived": false,
                "full_slug": "cell-blocks-red-ink-mass-incarceration-the-great-recession-3zeguy4452",
                "journal": {
                    "display_name": "Daedalus",
                    "official_page": "http://www.mitpressjournals.org/loi/daed",
                    "issn": "0011-5266",
                    "alias": null,
                    "id": 107749620,
                    "slug": "daedalus",
                    "unique_id": "yosonau4",

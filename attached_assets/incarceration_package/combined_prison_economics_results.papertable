                    "display_name": "Western Journal of Medicine",
                    "official_page": null,
                    "issn": "0093-0415",
                    "alias": [
                        "Transactions of the Medical Society of the State of California",
                        "California State Journal of Medicine",
                        "California and Western Medicine",
                        "California Medicine",

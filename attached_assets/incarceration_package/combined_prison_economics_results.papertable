        {
            "papers_j8QP6r": {
                "id": 2340259307,
                "title": "Opportunities for Cost Savings in Corrections Without Sacrificing Service Quality: Inmate Health Care",
                "is_archived": false,
                "full_slug": "opportunities-for-cost-savings-in-corrections-without-xaquefa4tr",
                "journal": null,
                "conference_series": null,
                "date": "2013-02-26 00:00:00+00:00",
                "is_oa": true,
                "publication_type": null,
                "doi": null,
                "unique_id": "xaquefa4tr",
                "abstract": "In many cities and counties, inmate health care comprises as much as a third of the cost of the corrections department. Options are presented on ways to substantially reduce the costs without reducing the quality of the care. We drew on practices of jails and prison across the nation. The approaches for cost reduction include ways to reduce demand or need for health care (e.g., screening need for hospitalization), and ways to reduce the cost per inmate when care is need (e.g. use of telemedicine.)",
                "authors": {
                    "total": 1,
                    "data": [
                        {

            "papers_j8QP6r": {
                "id": 36363332,
                "title": "Have sentence enhancements had a deterrent effect on crime and what are the social welfare implications of these laws",
                "is_archived": false,
                "full_slug": "have-sentence-enhancements-had-a-deterrent-effect-on-crime-42vlvrpq5f",
                "journal": null,
                "conference_series": null,
                "date": "2014-01-01 00:00:00+00:00",
                "is_oa": true,
                "publication_type": null,
                "doi": null,
                "unique_id": "42vlvrpq5f",
                "abstract": "In the early 1990s many states adopted some form of sentence enhancement law for repeat offenders. A three-strike law in many states, most notably California\u2019s, was a common form of these laws. Using a difference-in-difference methodology, this thesis demonstrates that sentence enhancement laws reduce property crime rates by 10 percent or more. A basic cost-benefit analysis, however, leaves open the question of whether social welfare is enhanced by sentence enhancements.",

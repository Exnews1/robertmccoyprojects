        {
            "papers_j8QP6r": {
                "id": 2125981409,
                "title": "Elderly inmates: issues for Australia",
                "is_archived": false,
                "full_slug": "elderly-inmates-issues-for-australia-k64iipw3lz",
                "journal": {
                    "display_name": "Trends and issues in crime and criminal justice",
                    "official_page": "http://www.aic.gov.au/en/publications/current%20series/tandi.aspx",
                    "issn": "0817-8542",
                    "alias": [
                        "Trends & issues in crime and criminal justice"
                    ],
                    "id": 2764966318,
                    "slug": "trends-and-issues-in-crime-and-criminal-justice",
                    "unique_id": "3pfwvaiu",
                    "full_slug": "trends-and-issues-in-crime-and-criminal-justice-3pfwvaiu"
                },
                "conference_series": null,
                "date": "1999-05-01 00:00:00+00:00",
                "is_oa": true,
                "publication_type": "Journal Article",
                "doi": null,
                "unique_id": "k64iipw3lz",
                "abstract": "As is the case with Australia's population in general, Australia's prison population is ageing. The number of prisoners over 50 years of age is increasing\u2014either because people are entering prison relatively late in life, or because they are serving longer sentences and growing old in prison. This poses new challenges for Australian correctional administrators. Older prisoners may be expected to experience more health problems than their younger counterparts, and the cost of keeping them in custody will be that much greater. Problems may arise from their presence in an environment comprised predominantly of younger men. And older prisoners released into the community after many years in prison may face difficulty in adjusting to life on the outside, particularly if they are without family or friends. This paper discusses demographic changes in Australia's prison popula- tion and their implication for Australian correctional management.",
                "authors": {
                    "total": 1,
                    "data": [
                        {
                            "display_name": "Anna Grant",
                            "id": 2169740008,
                            "slug": "anna-grant",
                            "unique_id": "3uut1uvebg",
                            "full_slug": "anna-grant-3uut1uvebg"
                        }
                    ]
                },
                "affiliations": {
                    "total": 0,
                    "data": []
                },
                "is_fulltext_request_allowed": false,
                "fulltext_url": null,
                "fulltext_url_no_follow": true,
                "paper_urls": {
                    "order": [],

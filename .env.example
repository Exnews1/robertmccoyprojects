# Copy this file to .env and fill in your values
# Used by: aws/docker-compose.aws.yml and local development

# PostgreSQL connection string
# Local Docker: postgresql://meridian:localdevonly@db:5432/meridian_kms
# AWS RDS:       postgresql://meridian:PASSWORD@HOST.rds.amazonaws.com:5432/meridian_kms
DATABASE_URL=postgresql://meridian:localdevonly@db:5432/meridian_kms

# Random secret for signing session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-64-char-string

# OpenAI API key – powers the AI document classification engine
OPENAI_API_KEY=sk-proj-...

# Local DB password (only used by docker-compose.aws.yml)
DB_PASSWORD=localdevonly
